    - target: {fileID: 6414135619091658438, guid: f80e318b29c38c34881a91bdab3ac8c3, type: 3}
      propertyPath: m_text
      value: "<b>Retrain your Brain with 5 Short Memory Exercises!</b>\r\nNumber
        1: Reverse Sentences\r\nFor example: If your friend says, \u2018The sky is
        clear tonight,\u2019 you would say, \u2018Tonight clear is sky the.\u2019\r\nAim
        to do this at least [VAR] times per day for maximum results, including faster
        recall and reduction of the appearance of dementia symptoms.\r\n"
      objectReference: {fileID: 0}
